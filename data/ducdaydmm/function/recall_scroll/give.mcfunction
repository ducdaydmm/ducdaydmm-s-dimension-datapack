# ===== Give Recall Scroll =====
# Gives the Recall Scroll item to the executing player
# Base item: paper with consumable component for right-click detection
give @s paper[item_name={"text":"✦ Recall Scroll","color":"light_purple","italic":false},lore=[{"text":"Right-click to recall to World Origin","color":"gray","italic":false}],custom_data={recall_scroll:1b},food={nutrition:0,saturation:0f,can_always_eat:true},consumable={consume_seconds:0.1f,animation:"none",has_consume_particles:false,sound:"minecraft:item.book.page_turn"}]
